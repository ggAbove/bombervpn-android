  "narrative": {
    "northStar": "Dependable connection control",
    "overview": "A dependable connection control built from the established Ink/Mist identity and native Material 3. Quiet surfaces, amber actions, and the owned signal-bomb mark give the Android client its character; connection state and the next action carry the hierarchy.\n\nThis is an extension of the existing v2rayNG surface, with the service engine retaining ownership of connection truth. It uses platform typography, interaction states, and navigation. The pinned brand and native platform were treated as an extension workflow; no replacement-world concept tournament, seed roll, or retrospective comp approval is claimed.",
    "keyCharacteristics": [
      "Native Material 3 components and scalable Android typography.",
      "Ink/Mist by default; wallpaper-derived colors are optional.",
      "Service state in words and icon treatment; test results remain separate.",
      "Owned vector identity, with no new shipping raster artwork."
    ],
    "rules": [
      {
        "name": "The Service Truth Rule",
        "body": "The signal mark and status follow the service state; connection testing reports its own result.",
        "section": "colors"
      },
      {
        "name": "The Native Roles Rule",
        "body": "Use Material typography roles and Android font scaling instead of adding a separate display type system.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use MaterialTheme color roles so light, dark, and optional dynamic themes remain coherent.",
      "Do retain native font scaling, scrollable content, safe insets, and the home/help width cap.",
      "Do keep status text and the signal tint tied to service state.",
      "Do retain explicit minimum action heights and allow longer translated labels to wrap."
    ],
    "donts": [
      "Don't claim protection or successful internet access merely because a connection was requested.",
      "Don't introduce gradients, glow, shield art, or invented connection metrics.",
      "Don't replace the owned vector mark with stock VPN imagery.",
      "Don't promote inherited diagnostic colors or compact utility controls into new brand primitives."
    ]
  }
}
